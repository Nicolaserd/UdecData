{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(bun:*)",
      "Bash(git commit --author:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npm i:*)",
      "PowerShell(npx:*)",
      "PowerShell(yarn:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Verificando reglas del proyecto"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-claude-dir.mjs\"",
            "timeout": 10,
            "statusMessage": "Protegiendo carpeta .claude"
          }
        ]
      }
    ]
  }
}
